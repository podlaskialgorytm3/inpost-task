# InPost Smart Finder — environment template
#
# The public InPost Global Points API does not require an API key.
# Copy to .env only if you add optional settings later.
#
# Example (unused by default):
# NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Optional: enables Google Maps photos on the point details page.
# Get a key with Places API enabled:
# https://developers.google.com/maps/documentation/places/web-service/get-api-key
# GOOGLE_MAPS_API_KEY=your_key_here
