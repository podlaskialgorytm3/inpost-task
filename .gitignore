# env files (keep .env.example committable for reviewers)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# IDE (optional; keep machine-specific settings out of the repo)
.vscode/
.idea/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
